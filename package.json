{
  "name": "dsh-codinput",
  "version": "0.6.0",
  "description": "把聊天输入框换成 CodeMirror 6 编辑器面板，支持普通 / 悬浮 / 侧栏三态、3D 悬浮与实时 Markdown 分屏预览。",
  "license": "MIT",
  "author": "Witherwithwinter",
  "icon": "./assets/icon.png",
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "codemirror",
    "composer",
    "input",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Witherwithwinter/DSH-Codinput.git"
  },
  "homepage": "https://github.com/Witherwithwinter/DSH-Codinput#readme",
  "bugs": {
    "url": "https://github.com/Witherwithwinter/DSH-Codinput/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/",
    "assets/",
    "locale/",
    "README.md",
    "README.en.md",
    "NOTICE",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "TESTING.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "check:popup": "node scripts/check-popup-contract.mjs",
    "test": "node scripts/test-unit.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run check:popup && npm test && npm run build && npm run typecheck",
    "prebuild": "node scripts/check-popup-contract.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "conversation"
      ],
      "external": [
        "react",
        "react-dom"
      ]
    }
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.7",
    "dompurify": "^3.2.4",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.0",
    "marked": "^15.0.6",
    "mermaid": "^12.3.0",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
